tmp_file=/tmp/code_terminal

#ghostpath
start='echo "ghostpath-on" > /tmp/code_terminal'
stop='echo "ghostpath-off" > /tmp/code_terminal'
change='echo "ghostpath change" > /tmp/code_terminal'

#macchanger
start_mac='echo "ghostpath start_mac" > /tmp/code_terminal'
stop_mac='echo "ghostpath stop_mac" > /tmp/code_terminal'
status_mac='echo "ghostpath status_mac" > /tmp/code_terminal'

#ip
status_ip='echo "ghostpath status_ip" > /tmp/code_terminal'

#tor
start_tor='echo "ghostpath start" > /tmp/code_terminal'
stop_tor='echo "ghostpath stop" > /tmp/code_terminal'
status_tor='echo "ghostpath status" > /tmp/code_terminal'

#privoxy
start_privoxy='echo "ghostpath start_privoxy" > /tmp/code_terminal'
stop_privoxy='echo "ghostpath stop_privoxy" > /tmp/code_terminal'
status_privoxy='echo "ghostpath status_privoxy" > /tmp/code_terminal'

#polipo
start_polipo='echo "ghostpath start_polipo" > /tmp/code_terminal'
stop_polipo='echo "ghostpath stop_polipo" > /tmp/code_terminal'
status_polipo='echo "ghostpath status_polipo" > /tmp/code_terminal'

#i2p
start_i2p='echo "ghostpath start_i2p" > /tmp/code_terminal'
stop_i2p='echo "ghostpath stop_i2p" > /tmp/code_terminal'
status_i2p='echo "ghostpath status_i2p" > /tmp/code_terminal'

#arm
start_arm='echo "ghostpath start_arm" > /tmp/code_terminal'

#wipe
wipe='echo "ghostpath wipe" > /tmp/code_terminal'

#hostname
change_hostname='echo "ghostpath change_hostname" > /tmp/code_terminal'
restore_hostname='echo "ghostpath restore_hostname" > /tmp/code_terminal'
status_hostname='echo "ghostpath status_hostname" > /tmp/code_terminal'

dim='8'

export MAIN_DIALOG='
<window window_position="1" title="ghostpath" resizable="true" image-name="emblem-people">
	<vbox>
		<hbox>
				<frame ghostpath>
					<button tooltip-text="Start ghostpath">
						<width>'$dim'</width>
						<label> START </label>
						<action>'$start'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Stop ghostpath">
						<width>'$dim'</width>
						<label> STOP </label>
						<action>'$stop'</action>
						<action type="refresh">terminale</action>	    
					</button>
				</frame>
				
				<frame Status>
					<button tooltip-text="Mac Status">
						<width>'$dim'</width>
						<label> MAC </label>
						<action>'$status_mac'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Hostname Status">
						<width>'$dim'</width>
						<label> HOSTNAME </label>
						<action>'$status_hostname'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="IP Status">
						<width>'$dim'</width>
						<label> IP </label>
						<action>'$status_ip'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Tor Status">
						<width>'$dim'</width>
						<label> TOR </label>
						<action>'$status_tor'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="I2P Status">
						<width>'$dim'</width>
						<label> I2P </label>
						<action>'$status_i2p'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Privoxy Status">
						<width>'$dim'</width>
						<label> PRIVOXY </label>
						<action>'$status_privoxy'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Polipo Status">
						<width>'$dim'</width>
						<label> POLIPO </label>
						<action>'$status_polipo'</action>
						<action type="refresh">terminale</action>
					</button>
			</frame>

			<frame Features>
				<frame Hostname>
					<button tooltip-text="Manually Change Hostname">
						<width>'$dim'</width>
						<label> CHANGE </label>
						<action>'$change_hostname'</action>
						<action type="refresh">terminale</action>
					</button>
					<button tooltip-text="Manually Restore Hostname">
						<width>'$dim'</width>
						<label> RESTORE </label>
						<action>'$restore_hostname'</action>
						<action type="refresh">terminale</action>
					</button>
				</frame>
				<frame Mac>
					<button tooltip-text="Manually Start Mac Spoofer">
						<width>'$dim'</width>
						<label> CHANGE </label>
						<action>'$start_mac'</action>
