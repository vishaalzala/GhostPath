						<width>'$dim'</width>
						<label> STOP </label>
						<action>'$stop_privoxy'</action>
						<action type="refresh">terminale</action>
					</button>
				</frame>
				<frame Polipo>
					<button tooltip-text="Manually Start Polipo">
